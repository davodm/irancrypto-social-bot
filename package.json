{
  "name": "irancrypto-social-bot",
  "version": "1.4.0",
  "description": "IranCrypto.market social bot which send daily stats and trends to different platforms",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "auth:twitter": "node -r dotenv/config scripts/auth-twitter.js",
    "deploy": "serverless deploy",
    "deploy:davod": "serverless deploy --aws-profile davod",
    "deploy:chromium": "./scripts/deploy-chromium-layer.sh",
    "deploy:chromium:davod": "./scripts/deploy-chromium-layer.sh --profile davod",
    "test": "node --test test/*.js",
    "test:functional": "node -r dotenv/config test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davodm/irancrypto-social-bot.git"
  },
  "keywords": [
    "twitter",
    "instagram",
    "telegram",
    "cryptocurrency",
    "irancrypto",
    "serverless",
    "nodejs"
  ],
  "author": "Davod Mozafari",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davodm/irancrypto-social-bot/issues"
  },
  "homepage": "https://github.com/davodm/irancrypto-social-bot#readme",
  "dependencies": {
    "@getlatedev/node": "^0.1.50",
    "@sentry/node": "^10.43.0",
    "file-type": "^21.3.1",
    "handlebars": "^4.7.8",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.27.0",
    "puppeteer-core": "^24.33.0",
    "re2": "^1.23.3",
    "social-post-api": "^1.1.1",
    "twitter-api-v2": "^1.29.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "dotenv": "^17.3.1",
    "prompt": "^1.3.0"
  }
}
