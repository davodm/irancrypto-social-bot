# ============================================
# REQUIRED - Core Configuration
# ============================================
DYNAMODB_TABLE=irancrypto-social-bot-prod
IRANCRYPTO_API_KEY=

# ============================================
# AI Configuration (at least one provider API key required)
# ============================================
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Set at least ONE of the following:
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ============================================
# Twitter Configuration
# ============================================
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=https://example.com/twitterbot/

# ============================================
# Instagram Configuration
# ============================================
# Provider: "ayrshare" or "late" (default: ayrshare)
INSTAGRAM_PROVIDER=ayrshare

# Ayrshare provider settings (required when INSTAGRAM_PROVIDER=ayrshare)
AYRSHARE_API_KEY=

# Late provider settings (required when INSTAGRAM_PROVIDER=late)
LATE_API_KEY=
LATE_IG_ACCOUNT_ID=

# ============================================
# Telegram Configuration
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ============================================
# Optional Configuration
# ============================================
SCHEDULE_TIMEZONE=Asia/Tehran
SENTRY_DSN=

# ============================================
# Auto-managed by Chromium deployment script
# Do NOT set these manually
# ============================================
# CHROMIUM_LAYER_ARN=
# CHROMIUM_LAYER_ARN_ARM64=
# CHROMIUM_VERSION=

# Local development only (path to local Chromium binary)
# CHROMIUM='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
